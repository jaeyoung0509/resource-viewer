FROM golang:1.25.4-alpine AS build
ARG TARGETARCH
WORKDIR /src
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
  go build -o /out/trace-svc ./cmd/trace-svc

FROM alpine:3.20
WORKDIR /app
RUN apk add --no-cache ca-certificates
COPY --from=build /out/trace-svc /app/trace-svc
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/app/trace-svc"]
